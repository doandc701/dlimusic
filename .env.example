# Lấy tại https://my.telegram.org -> API development tools
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
# Số điện thoại (định dạng quốc tế), để trống sẽ hỏi khi chạy
PHONE=+84xxxxxxxxx

# --- Lưu dữ liệu lên MongoDB Atlas (tuỳ chọn) ---
# Chuỗi kết nối lấy ở Atlas -> Connect -> Drivers. Để trống: dữ liệu chỉ lưu trên máy.
MONGODB_URI=
# Tên database (mặc định tele_downloader)
MONGODB_DB=
# Khoá mã hoá phiên Telegram trong MongoDB (16+ ký tự, giữ bí mật). Dùng cùng một khoá trên các máy
# muốn dùng chung dữ liệu; để trống thì mỗi máy tự tạo khoá riêng (phiên chỉ máy đó đọc được).
TDL_SECRET=
# Tên "máy" trong MongoDB (mặc định default). Đặt khác nhau nếu nhiều máy KHÔNG muốn dùng chung dữ liệu.
TDL_CLOUD_INSTANCE=

# --- Chia sẻ playlist bằng link (bản Vercel, tuỳ chọn; xem README "Chia sẻ playlist") ---
# Cloudflare R2: Account ID (32 ký tự), API token quyền Object Read & Write, tên bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
