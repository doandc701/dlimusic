# Biến môi trường của app DLiMusic (mobile). Chép file này thành .env rồi điền giá trị (.env không được commit).
# Thiếu biến nào thì app lấy từ ../.env của bản web (cùng tên API_ID / API_HASH).
# Khi build trên máy chủ Expo (EAS Build) không có file này: tạo các biến cùng tên bằng
#   npx eas-cli@latest env:create --environment production --name API_HASH --value ... --visibility sensitive

# Lấy tại https://my.telegram.org -> API development tools (dùng chung với bản web)
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef

# Máy chủ đồng bộ yêu thích / phát gần đây / hội thoại hiển thị với bản web (để trống: https://dlimusic.vercel.app)
CLOUD_URL=
