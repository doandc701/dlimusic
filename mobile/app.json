{
  "expo": {
    "name": "DLiMusic",
    "slug": "dlimusic",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "dlimusic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.dlimusic",
      "supportsTablet": true
    },
    "android": {
      "package": "app.dlimusic",
      "adaptiveIcon": {
        "backgroundColor": "#2b4f9e",
        "foregroundImage": "./assets/images/app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7c3aed",
          "image": "./assets/images/logo-192.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "449c2d93-3a85-4fc5-812a-cfa3ddb8f88b"
      }
    },
    "owner": "nadoyep",
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/449c2d93-3a85-4fc5-812a-cfa3ddb8f88b"
    }
  }
}
